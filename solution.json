{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.47.16.16243",
      "templateHash": "6332601607465510820"
    }
  },
  "parameters": {
    "intune": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Choose whether to Intune enroll the virtual machine."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "The location for the deployments."
      }
    },
    "timestamp": {
      "type": "string",
      "defaultValue": "[utcNow('yyyyMMddhhmmss')]",
      "metadata": {
        "description": "DO NOT MODIFY THIS VALUE! The timestamp is needed to differentiate deployments for certain Azure resources and must be set using a parameter."
      }
    },
    "virtualMachineResourceId": {
      "type": "string",
      "metadata": {
        "description": "The resource ID for the target virtual machine."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('EntraJoin_{0}', parameters('timestamp'))]",
      "subscriptionId": "[split(parameters('virtualMachineResourceId'), '/')[2]]",
      "resourceGroup": "[split(parameters('virtualMachineResourceId'), '/')[4]]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "intune": {
            "value": "[parameters('intune')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "virtualMachineResourceId": {
            "value": "[parameters('virtualMachineResourceId')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.47.16.16243",
              "templateHash": "17515706534815305966"
            }
          },
          "parameters": {
            "intune": {
              "type": "bool",
              "defaultValue": false
            },
            "location": {
              "type": "string"
            },
            "virtualMachineResourceId": {
              "type": "string"
            }
          },
          "resources": [
            {
              "type": "Microsoft.Compute/virtualMachines/extensions",
              "apiVersion": "2021-03-01",
              "name": "[format('{0}/{1}', split(parameters('virtualMachineResourceId'), '/')[8], 'AADLoginForWindows')]",
              "location": "[parameters('location')]",
              "properties": {
                "publisher": "Microsoft.Azure.ActiveDirectory",
                "type": "AADLoginForWindows",
                "typeHandlerVersion": "2.0",
                "autoUpgradeMinorVersion": true,
                "settings": "[if(parameters('intune'), createObject('mdmId', '0000000a-0000-0000-c000-000000000000'), null())]"
              }
            }
          ]
        }
      }
    }
  ]
}